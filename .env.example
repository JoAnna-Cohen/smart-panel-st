# -----------------------------------------------------------------------
# Leviton Smart Panel – SmartThings Schema Connector
# Copy this file to ".env" and fill in your values before running.
# -----------------------------------------------------------------------

# ---- SmartThings Developer Center values -------------------------------
# https://developer.smartthings.com/

# The OAuth Client ID / Secret YOU typed into the Schema App's OAuth
# settings. SmartThings sends them when calling /oauth/token.
ST_CLIENT_ID=your-oauth-client-id
ST_CLIENT_SECRET=your-oauth-client-secret

# The Client ID / Secret SMARTTHINGS shows you after saving the Schema App.
# Used to get callback tokens so worker.py can push live state.
ST_CALLBACK_CLIENT_ID=smartthings-issued-client-id
ST_CALLBACK_CLIENT_SECRET=smartthings-issued-client-secret

# Device profile IDs created from smartthings/profiles/ (see SMARTTHINGS.md).
# Panels and CT clamps are skipped until their profile is set; breakers
# fall back to the built-in c2c-switch-power-energy handler. Solar CTs use
# ST_PROFILE_SOLAR, or ST_PROFILE_CT if that is blank.
ST_PROFILE_BREAKER=
ST_PROFILE_PANEL=
ST_PROFILE_CT=
ST_PROFILE_SOLAR=

# ---- Security ----------------------------------------------------------

# Signs Flask session cookies.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Encrypts stored Leviton credentials. Back this up: if it's lost, every
# linked account has to be re-linked.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=

# ---- Server ------------------------------------------------------------

# Port for `python app.py` (gunicorn uses gunicorn.conf.py: 127.0.0.1:5001).
PORT=5001

# Directory for token / link JSON files. Must be writable by the service
# user and NOT inside the web root.
DATA_DIR=./data

# Seconds between background pushes to SmartThings (worker.py). 900 = 15
# minutes, the shortest interval SmartThings accepts energy reports at.
PUSH_INTERVAL=900

# Energy totals are power x time between readings; a gap longer than this
# (seconds, e.g. panel offline) is skipped instead of estimated.
ENERGY_MAX_GAP=2100

# stateRefresh requests reuse data fetched within this many seconds.
SNAPSHOT_MAX_AGE=60

# Set to "1" for verbose logging. DEBUG_LEVITON=1 also logs raw Leviton
# API responses (very noisy).
# DEBUG=1
# DEBUG_LEVITON=1
